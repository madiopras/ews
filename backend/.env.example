# Core backend
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=wisatasumut
JWT_SECRET=replace-with-a-long-random-secret
ENVIRONMENT=development
APP_NAME=Explore Wisata Sumut
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
PUBLIC_APP_URL=http://localhost:3000
BACKUP_DIR=./backups

# Bootstrap admin. Use an explicit strong password outside local development.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Direct Google Identity Services. The Client ID is public and is exposed to
# the frontend through GET /api/auth/google/config. No Client Secret is needed.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=

# OpenAI-compatible Planner provider and encrypted runtime profiles.
USE_LLM=true
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=
LLM_MODEL_NAME=dios-chat
LLM_PROFILE_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret
LLM_ALLOW_PRIVATE_URLS=true
LLM_ALLOWED_HOSTS=

# Authentication email delivery. Without SMTP_HOST, messages remain in the
# email_outbox collection with status "configuration_required".
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@wisatasumut.id

# Optional transactional SMS webhook. The backend POSTs JSON containing
# recipient, kind, and body. Without this value, delivery is recorded as
# "configuration_required" instead of being reported as sent.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# Object storage. Leave EMERGENT_LLM_KEY empty to use local storage.
INTEGRATION_PROXY_URL=https://integrations.emergentagent.com
EMERGENT_LLM_KEY=
STORAGE_DIR=./storage

# Midtrans. Only the credential set selected by MIDTRANS_ENV is required.
MIDTRANS_ENV=sandbox
MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_MERCHANT_ID_PRODUCTION=
MIDTRANS_CLIENT_KEY_PRODUCTION=
MIDTRANS_SERVER_KEY_PRODUCTION=

# Reserved for future distributed quota/cache infrastructure.
REDIS_URL=
